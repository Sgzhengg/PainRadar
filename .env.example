# --- LLM extractor (optional) -------------------------------------------
# Leave empty to use the offline rule extractor.
# Any OpenAI-compatible endpoint works (DeepSeek, Qwen, vLLM, Ollama ...).
PAINRADAR_LLM_BASE_URL=
PAINRADAR_LLM_API_KEY=
PAINRADAR_LLM_MODEL=

# --- Reddit (optional but recommended) ----------------------------------
# Create a "script" app at https://www.reddit.com/prefs/apps
# Without these the connector falls back to public JSON, which Reddit often
# blocks (timeouts / 403) for unauthenticated clients.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=PainRadar/0.1 by <your-reddit-username>

# --- Ledger -------------------------------------------------------------
# PAINRADAR_DB=E:\PainRadar\var\painradar.db

# --- Zeabur private deployment -------------------------------------------
# SQLite lives under this directory. On Zeabur mount a volume at /app/var.
# PAINRADAR_DATA_DIR=/app/var
PAINRADAR_STORE=local

# Optional single-user lock. Empty = local development without auth.
# If set, the whole site asks for Basic Auth and remembers you for 30 days.
PAINRADAR_ADMIN_PASSWORD=

# MediaCrawler service in the SAME Zeabur project (internal network).
# Local dev example: http://127.0.0.1:8080
MEDIACRAWLER_API_URL=http://mediacrawler.zeabur.internal:8080
MEDIACRAWLER_API_TOKEN=
REMOTE_CRAWL_TIMEOUT=900
REMOTE_CRAWL_INTERVAL=3

# Platform cookies are configured on the MediaCrawler service, e.g.
# PLATFORM_COOKIES_XHS=... / _DY / _BILI / _ZHIHU
